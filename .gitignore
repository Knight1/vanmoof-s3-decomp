# Build output
build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst

# Editor
.vscode/
.idea/
*.swp
*~

# Pre-decomp backups kept locally during incremental rewrites of
# speculative modules. Not for upstream.
*.bak

# Ghidra exports may be regenerated; keep small JSON, ignore large dumps.
# Leading `**/` matches at any depth (the previous slash-anchored form
# only matched at the repo root, so per-ware exports leaked through).
**/ghidra/exports/*.bndb
**/ghidra/exports/*.gar
# Per-function / per-region scratch dumps produced by DumpShifterFunction.java,
# DumpShifterRegion.java, SearchShifterPointer.java, etc. — each one
# overwrites the previous run; meaningful findings get folded into
# docs/progress.md as prose, so the raw .txt is throwaway.
**/ghidra/exports/*.txt

# OEM firmware images — never commit, even by accident
shifterware_*.bin
shifterware_*.elf
mainware*.bin
batteryware*.bin
motorware*.bin
bleware*.bin
bleboot*.bin
*.pak
SPI-Flash_*.rom
*.rom

# TI SDK vendor directory — user-downloaded, never committed
bleware/vendor/ti-sdk-3.40/

# Renode
logs/*
snapshots/*
log.html
report.html
robot_output.xml
*.save
*.log